# Copy to .env and edit.  cp .env.example .env

# Public HTTPS address of the portal (used in emails and secure invite links)
APP_BASE_URL=https://onboarding.example.com.mt

# Only these email domains can be invited / sign in (comma separated). CONFIRM THE REAL DOMAINS.
ALLOWED_EMAIL_DOMAINS=melita.com,smarttech.com.mt

# Technical team mailbox(es) notified when an onboarding sheet is submitted
TECH_TEAM_EMAILS=

# Outbound email (optional – without it the portal still works; notifications are just not emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=smartcloud-portal@example.com.mt

# Keep 1 in production (portal served over HTTPS). Set 0 only for local testing over plain HTTP.
COOKIE_SECURE=1
CURRENCY_SYMBOL=€

# Optional: fixed session secret. If empty, one is generated and stored in data/.secret_key
SECRET_KEY=
