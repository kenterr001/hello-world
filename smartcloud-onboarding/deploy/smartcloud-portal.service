# systemd unit for running WITHOUT Docker (see README, option B)
[Unit]
Description=Smart Cloud Sales & Onboarding Portal
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/smartcloud-portal
EnvironmentFile=/opt/smartcloud-portal/.env
Environment=DATA_DIR=/opt/smartcloud-portal/data
ExecStart=/opt/smartcloud-portal/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 app:app
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/smartcloud-portal/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
